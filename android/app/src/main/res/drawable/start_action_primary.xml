<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" android:paddingMode="stack">
    <!-- Flat offset shadow, matching the selected Lemon Play design. -->
    <item android:left="3dp" android:top="3dp">
        <shape><solid android:color="@color/start_ink"/><corners android:radius="12dp"/></shape>
    </item>
    <item android:right="3dp" android:bottom="3dp">
        <ripple android:color="#2424271F">
            <item>
                <shape>
                    <solid android:color="@color/start_accent"/>
                    <corners android:radius="12dp"/>
                    <stroke android:width="2dp" android:color="@color/start_ink"/>
                </shape>
            </item>
        </ripple>
    </item>
</layer-list>
