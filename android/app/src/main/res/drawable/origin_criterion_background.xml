<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">
        <shape>
            <solid android:color="#F8EDB2" />
            <corners android:radius="11dp" />
            <stroke android:width="1dp" android:color="@color/start_ink" />
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="@color/start_background" />
            <corners android:radius="11dp" />
        </shape>
    </item>

</selector>
