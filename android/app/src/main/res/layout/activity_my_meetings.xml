<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/start_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="24dp" android:paddingVertical="12dp" android:gravity="center_vertical">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/backButton"
            android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp"
            android:text="‹" android:textSize="28sp" android:contentDescription="시작 화면으로"
            android:textColor="@color/start_ink" android:background="?attr/selectableItemBackgroundBorderless" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="end" android:text="@string/start_logo" android:textSize="18sp"
            android:textStyle="bold" android:textColor="@color/start_ink" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp" android:layout_marginTop="20dp"
        android:text="내 약속" android:textSize="30sp" android:textStyle="bold" android:textColor="@color/start_ink" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp" android:layout_marginTop="8dp" android:layout_marginBottom="24dp"
        android:text="이 휴대폰에서 참여한 약속이에요." android:textSize="13sp" android:textColor="@color/start_muted" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:paddingHorizontal="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="8dp">
            <ProgressBar android:id="@+id/loading" android:layout_width="40dp" android:layout_height="40dp"
                android:layout_gravity="center_horizontal" android:indeterminateTint="@color/start_point" />
            <ImageView android:id="@+id/emptyIcon" android:layout_width="64dp" android:layout_height="64dp"
                android:layout_gravity="center_horizontal" android:layout_marginTop="64dp" android:layout_marginBottom="20dp"
                android:background="@drawable/alarm_avatar_background" android:src="@drawable/ic_point_calendar"
                android:padding="18dp" android:importantForAccessibility="no" android:visibility="gone" />
            <TextView android:id="@+id/emptyTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:textSize="22sp" android:textStyle="bold"
                android:textColor="@color/start_ink" android:visibility="gone" />
            <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingVertical="20dp" android:gravity="center" android:textSize="14sp"
                android:lineSpacingExtra="5dp" android:textColor="@color/start_muted" android:accessibilityLiveRegion="polite" />
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/retryButton"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal"
                android:minHeight="48dp" android:padding="12dp" android:text="다시 불러오기"
                android:background="@drawable/start_action_secondary" app:backgroundTint="@null" android:textColor="@color/start_ink" />
            <LinearLayout android:id="@+id/meetingList" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton android:id="@+id/createButton"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="24dp"
        android:layout_marginTop="16dp" android:minHeight="62dp" android:padding="12dp"
        android:background="@drawable/nearby_primary_background" app:backgroundTint="@null"
        android:text="＋ 약속 만들기" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/start_ink" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/joinButton"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
        android:layout_marginHorizontal="24dp" android:layout_marginBottom="12dp" android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground" android:text="초대 참여" android:textColor="@color/start_ink" />
</LinearLayout>
