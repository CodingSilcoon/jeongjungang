<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" android:background="@drawable/start_action_secondary"
    android:orientation="vertical" android:padding="14dp">

    <LinearLayout android:id="@+id/permissionHead" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <ImageView android:id="@+id/permissionIcon" android:layout_width="32dp" android:layout_height="32dp"
            android:background="@drawable/point_badge_background" android:padding="6dp"
            android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/permissionTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold"
                android:textColor="@color/start_ink" />
            <TextView android:id="@+id/permissionRequirement" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="11sp" android:textColor="@color/start_muted" />
        </LinearLayout>
        <TextView android:id="@+id/permissionAllowed" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:drawableStart="@drawable/ic_point_check"
            android:drawablePadding="4dp" android:text="허용됨" android:textSize="12sp"
            android:textStyle="bold" android:textColor="@color/start_point" />
    </LinearLayout>

    <TextView android:id="@+id/permissionDescription" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:textSize="12sp" android:lineSpacingExtra="3dp" android:textColor="@color/start_muted" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/permissionAction"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="end" android:layout_marginTop="8dp" android:minHeight="48dp"
        android:minWidth="80dp" android:paddingHorizontal="12dp" android:text="설정하기"
        android:textSize="12sp" android:textColor="@color/start_ink" android:textAllCaps="false"
        android:background="@drawable/start_action_secondary" app:backgroundTint="@null" />
</LinearLayout>
