<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/start_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:paddingHorizontal="24dp" android:paddingVertical="12dp">
        <androidx.appcompat.widget.AppCompatButton android:id="@+id/backButton"
            android:layout_width="48dp" android:layout_height="48dp" android:minWidth="0dp"
            android:text="‹" android:textSize="28sp" android:textColor="@color/start_ink"
            android:contentDescription="이전 화면" android:background="?attr/selectableItemBackgroundBorderless" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="end" android:text="@string/start_logo" android:textSize="18sp"
            android:textStyle="bold" android:textColor="@color/start_ink" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:paddingHorizontal="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="8dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:text="약속 놓치지 않도록"
                android:textSize="30sp" android:textStyle="bold" android:textColor="@color/start_ink" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:layout_marginBottom="24dp"
                android:text="출발 알람에 필요한 설정을 확인해 주세요."
                android:textSize="13sp" android:textColor="@color/start_muted" />
            <LinearLayout android:id="@+id/permissionRows" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <TextView android:id="@+id/permissionHint" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp" android:gravity="center" android:textSize="12sp"
        android:accessibilityLiveRegion="polite" android:textColor="@color/start_muted" />
    <androidx.appcompat.widget.AppCompatButton android:id="@+id/doneButton"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp" android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp" android:minHeight="64dp" android:padding="14dp"
        android:background="@drawable/nearby_primary_background" app:backgroundTint="@null"
        android:text="확인했어요" android:textSize="19sp" android:textStyle="bold"
        android:textColor="@color/start_ink" android:textAllCaps="false" />
</LinearLayout>
