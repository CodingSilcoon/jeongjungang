<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/start_background">

    <!-- 상태 표시줄 안쪽에 배치하는 공통 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="22dp"
        android:paddingTop="12dp"
        android:gravity="center_vertical">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="14dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/origin_back"
            android:rotation="180"
            app:srcCompat="@drawable/start_chevron" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/start_logo"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/start_ink" />
    </LinearLayout>

    <!-- 목록이 남은 높이를 사용하고, 하단 버튼은 스크롤 밖에 둔다. -->
    <LinearLayout
        android:id="@+id/entryPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="22dp">

        <TextView
            style="@style/OriginTitle"
            android:text="@string/origin_title" />

        <TextView
            style="@style/OriginLead"
            android:text="@string/origin_intro" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/participantScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/participantList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/addButton"
                    style="@style/OriginButton"
                    android:layout_marginTop="4dp"
                    android:minHeight="48dp"
                    android:textSize="14sp"
                    android:background="@drawable/origin_add_background"
                    android:text="@string/origin_add"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <TextView
            android:id="@+id/entryHint"
            style="@style/OriginText"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="@color/start_muted"
            android:accessibilityLiveRegion="polite" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/findButton"
            style="@style/OriginButton"
            android:layout_marginBottom="24dp"
            android:text="@string/origin_find"
            android:enabled="false"
            app:backgroundTint="@null" />
    </LinearLayout>

    <!-- 출발지 검색: 실제 검색 ViewModel의 결과를 표시한다. -->
    <LinearLayout
        android:id="@+id/searchPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:visibility="gone">

        <TextView
            style="@style/OriginTitle"
            android:text="@string/origin_search_title" />

        <TextView
            android:id="@+id/searchFor"
            style="@style/OriginLead" />

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="58dp"
            android:padding="16dp"
            android:background="@drawable/start_action_secondary"
            android:backgroundTint="@null"
            android:hint="@string/origin_search_hint"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:maxLength="100"
            android:textSize="16sp"
            android:textColor="@color/start_ink"
            android:textColorHint="@color/start_muted" />

        <TextView
            android:id="@+id/searchNotice"
            style="@style/OriginLead"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/searchStatus"
            style="@style/OriginText"
            android:layout_marginVertical="8dp"
            android:accessibilityLiveRegion="polite" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/searchResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>



</LinearLayout>
