<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 이하 자동 백업 규칙. Android 12 이상은 data_extraction_rules.xml을 쓴다.
   https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- 참가자 토큰: Keystore 키는 기기 밖으로 안 나가서 다른 기기에서는 복호화할 수 없다 -->
    <exclude domain="sharedpref" path="meeting_tokens.xml" />
    <!-- 알람 예약·끈 기록: 이 기기 전용. 다른 기기에서 울리면 안 된다 -->
    <exclude domain="sharedpref" path="alarms.xml" />
    <exclude domain="sharedpref" path="alarm_dismiss_queue.xml" />
    <exclude domain="sharedpref" path="alarm_links.xml" />
</full-backup-content>
