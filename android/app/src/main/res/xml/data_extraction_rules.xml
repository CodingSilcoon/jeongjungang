<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12 이상 백업·기기 이전 규칙.
   https://developer.android.com/about/versions/12/backup-restore#xml-changes
   제외 이유는 backup_rules.xml 참고.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="meeting_tokens.xml" />
        <exclude domain="sharedpref" path="alarms.xml" />
        <exclude domain="sharedpref" path="alarm_dismiss_queue.xml" />
        <exclude domain="sharedpref" path="alarm_links.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="meeting_tokens.xml" />
        <exclude domain="sharedpref" path="alarms.xml" />
        <exclude domain="sharedpref" path="alarm_dismiss_queue.xml" />
        <exclude domain="sharedpref" path="alarm_links.xml" />
    </device-transfer>
</data-extraction-rules>
