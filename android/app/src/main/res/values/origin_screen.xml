    <style name="OriginText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/start_ink</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="OriginTitle" parent="OriginText">
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:accessibilityHeading">true</item>
    </style>

    <style name="OriginLead" parent="OriginText">
        <item name="android:textColor">@color/start_muted</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:layout_marginBottom">24dp</item>
    </style>

    <style name="OriginButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:padding">16dp</item>
