# DOMAIN은 deploy/.env에서 온다. 실제 도메인이면 Let's Encrypt 인증서를 자동으로 받고,
# localhost면 Caddy 자체 인증서를 쓴다(로컬 확인용)
# 이 폴더(deploy/caddy)를 통째로 /etc/caddy에 마운트한다. 파일 하나만 마운트하면 git pull 뒤에도 예전 내용이 보이기 때문
{$DOMAIN} {
	encode gzip

	# API만 앱으로 넘긴다. actuator 등 나머지 경로는 밖에 열지 않는다
	handle /api/* {
		reverse_proxy app:8080
	}

	# Android App Links 확인용. 리다이렉트 없이 application/json으로 줘야 한다
	handle /.well-known/assetlinks.json {
		root * /etc/caddy/site
		header Content-Type application/json
		file_server
	}

	# 초대 링크 https://{도메인}/m/{코드}. 앱이 없을 때 보이는 안내 페이지 (코드는 invite.js가 주소에서 읽는다)
	# 초대 코드는 대문자·숫자 8자라 /m/invite.js와 겹치지 않는다
	handle /m/* {
		root * /etc/caddy/site
		@script path /m/invite.js
		rewrite @script /invite.js
		rewrite * /invite.html
		header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		header Referrer-Policy no-referrer
		header Cache-Control "no-cache"
		file_server
	}

	handle {
		respond 404
	}
}
