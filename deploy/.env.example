# 복사해서 deploy/.env로 만들고 값을 채운다. .env는 git에 올리지 않는다
#   cp .env.example .env && chmod 600 .env

# HTTPS 인증서와 초대 링크(https://{DOMAIN}/m/{코드})에 쓴다. 로컬 확인은 localhost
DOMAIN=jeongjungang.duckdns.org

# 처음 띄울 때 정한 값이 DB에 저장된다. 나중에 바꾸면 DB 쪽 비밀번호도 같이 바꿔야 한다
# 예: openssl rand -base64 24
DB_PASSWORD=

# 카카오 REST 키. 비우면 /geocode·/places만 502가 난다
KAKAO_REST_API_KEY=
